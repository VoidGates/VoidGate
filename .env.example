# Plain NAME=value lines, saved as UTF-8: no quotes, no `export`, no comment after a value.
# Unknown VOIDGATE_* names stop the service from starting.
# Use a randomly generated secret of at least 32 characters.
VOIDGATE_API_KEY=
VOIDGATE_DECOY_PATHS=/internal/backup
VOIDGATE_BIND=127.0.0.1:8080
# Decision requests allowed per minute for the credential (burst included).
VOIDGATE_RATE_LIMIT_PER_MINUTE=60
# Development builds only (0 or 1): serves Swagger UI at /docs. Refused unless the bind is loopback.
VOIDGATE_DEV_DOCS=0
